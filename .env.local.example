# Database (role + database created by scripts/setup-db.sh in the postgres18 container)
DATABASE_URL="postgresql://poketrain:poketrain_dev_password@localhost:5432/poketrain_dev?schema=public"

# Where the app is reached, for the links `npm run accounts` prints (invites, password resets)
APP_URL="http://localhost:3000"

# Lets people save their own AI key in Settings: it is stored encrypted with this secret.
# Make one with `openssl rand -base64 32`. Changing it makes saved keys unreadable (people add them again).
# AI_KEY_SECRET=""

# AI audits and research (optional -- no key means no-AI mode, the app still works)
AI_PROVIDER="openai"          # "openai" | "claude"
# OPENAI_API_KEY="sk-..."
# OPENAI_BULK_MODEL="gpt-4o-mini"            # everyday requests (one Pokémon, a location)
# OPENAI_ESCALATION_MODEL="gpt-4o"           # harder ones (whole roster, starter team)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."        # REQUIRED if the API answers 400 "not scoped to a workspace"; same value taxap uses
# CLAUDE_BULK_MODEL="claude-haiku-4-5"       # everyday requests
# CLAUDE_ESCALATION_MODEL="claude-sonnet-5-5" # harder ones
# CLAUDE_MODEL / OPENAI_MODEL still work: one model used for both when the pair above is not set
