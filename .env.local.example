# Database (role + database created by scripts/setup-db.sh in the postgres18 container)
DATABASE_URL="postgresql://poketrain:poketrain_dev_password@localhost:5432/poketrain_dev?schema=public"

# Where the app is reached, for the links `npm run accounts` prints (invites, password resets)
APP_URL="http://localhost:3000"

# Encrypts the AI keys people save in Settings (the app holds no AI key of its own: each person, the owner
# included, sets up their provider, key, workspace and model there). Required to save a key.
# Make one with `openssl rand -base64 32`. Changing it makes saved keys unreadable (people add them again).
# ENCRYPTION_SECRET=""
