// Prisma schema for poketrain.
// Two halves:
//  - Reference data: synced from PokéAPI by scripts/sync-pokeapi.ts, never
//    edited by the app. Integer ids are PokéAPI's own ids.
//  - User data: profiles, dex progress, roster, breeding goals. UUID ids.
// Names are stored in English and Spanish because imported spreadsheets
// may use either.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Reference data (PokéAPI)
// ============================================================================

model Game {
  id           String @id // slug, e.g. "violet"
  name         String
  versionGroup String @map("version_group") // PokéAPI version group, e.g. "scarlet-violet"
  generation   Int
  sortOrder    Int    @default(0) @map("sort_order")

  profiles GameProfile[]

  @@map("games")
}

/// A species as listed in the National Pokédex. `id` is the national number.
model Species {
  id            Int      @id
  slug          String   @unique
  nameEn        String   @map("name_en")
  nameEs        String   @map("name_es")
  eggGroups     String[] @map("egg_groups")
  /// Eighths that are female; -1 means genderless.
  genderRate    Int      @map("gender_rate")
  isBaby        Boolean  @default(false) @map("is_baby")
  /// Legendary or mythical: left out of the list of Pokémon to battle for EVs.
  isSpecial     Boolean  @default(false) @map("is_special")
  evolvesFromId Int?     @map("evolves_from_id")

  evolvesFrom Species?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo   Species[] @relation("Evolution")

  forms          Form[]
  locations      PokemonLocation[]
  pokedexSlots   PokedexSlot[]
  pokedexEntries PokedexEntry[]
  roster         RosterPokemon[]   @relation("RosterSpecies")
  rosterBase     RosterPokemon[]   @relation("RosterBaseSpecies")
  rosterFinal    RosterPokemon[]   @relation("RosterFinalSpecies")
  breedingGoals  BreedingGoal[]
  opponents      BattleOpponent[]

  @@map("species")
}

/// A battle-distinct variety of a species (PokéAPI "pokemon"): the default
/// form plus regional forms such as Paldean Wooper. Learnsets hang off this.
model Form {
  id        Int      @id
  speciesId Int      @map("species_id")
  slug      String   @unique
  isDefault Boolean  @map("is_default")
  types     String[]
  /// { hp, attack, defense, specialAttack, specialDefense, speed }
  baseStats Json     @map("base_stats")
  /// EVs it gives when defeated, as { hp, attack, ... } (only the stats that are above 0).
  evYield   Json?    @map("ev_yield")
  spriteUrl String?  @map("sprite_url")

  species   Species         @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  learnsets Learnset[]
  abilities FormAbility[]
  roster    RosterPokemon[]

  @@index([speciesId])
  @@map("forms")
}

model Move {
  id          Int    @id
  slug        String @unique
  nameEn      String @map("name_en")
  nameEs      String @map("name_es")
  type        String
  damageClass String @map("damage_class") // physical | special | status
  power       Int?
  accuracy    Int?
  pp          Int?

  learnsets   Learnset[]
  rosterMoves RosterMove[]

  @@map("moves")
}

model Learnset {
  id           Int    @id @default(autoincrement())
  formId       Int    @map("form_id")
  moveId       Int    @map("move_id")
  versionGroup String @map("version_group")
  method       String // level-up | machine | egg | tutor | ...
  level        Int    @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  move Move @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@unique([formId, moveId, versionGroup, method, level])
  @@index([versionGroup, moveId, method])
  @@map("learnsets")
}

model Ability {
  id            Int     @id
  slug          String  @unique
  nameEn        String  @map("name_en")
  nameEs        String  @map("name_es")
  /**
   * What it does, in a sentence (PokéAPI short effect / flavor text).
   */
  descriptionEn String? @map("description_en")
  descriptionEs String? @map("description_es")

  forms  FormAbility[]
  roster RosterPokemon[]

  @@map("abilities")
}

model FormAbility {
  formId    Int     @map("form_id")
  abilityId Int     @map("ability_id")
  isHidden  Boolean @map("is_hidden")

  form    Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  ability Ability @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  @@id([formId, abilityId])
  @@map("form_abilities")
}

model Item {
  id        Int     @id
  slug      String  @unique
  nameEn    String  @map("name_en")
  nameEs    String  @map("name_es")
  category  String
  spriteUrl String? @map("sprite_url")

  roster RosterPokemon[]

  @@map("items")
}

model Nature {
  id        Int     @id
  slug      String  @unique
  nameEn    String  @map("name_en")
  nameEs    String  @map("name_es")
  /// Stat slugs; both null for neutral natures.
  increased String?
  decreased String?

  rosterTarget  RosterPokemon[] @relation("TargetNature")
  rosterCurrent RosterPokemon[] @relation("CurrentNature")
  rosterMint    RosterPokemon[] @relation("MintNature")
  rosterStats   RosterPokemon[] @relation("StatsNature")

  @@map("natures")
}

/// Which games list a Pokédex, and in what order, is in the game config (`pokedexes` in
/// src/lib/games), so paired games such as Scarlet and Violet can share one.
model Pokedex {
  id   Int    @id
  slug String @unique
  name String

  slots PokedexSlot[]

  @@map("pokedexes")
}

model PokedexSlot {
  pokedexId   Int @map("pokedex_id")
  speciesId   Int @map("species_id")
  entryNumber Int @map("entry_number")

  pokedex Pokedex @relation(fields: [pokedexId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([pokedexId, speciesId])
  @@index([pokedexId, entryNumber])
  @@map("pokedex_slots")
}

/// Type effectiveness chart from PokéAPI: what `attacker` moves do to a `defender` type
/// (0, 0.5, 1 or 2). Only the non-neutral pairs are stored; anything missing is 1.
model TypeEffect {
  attacker   String
  defender   String
  multiplier Float

  @@id([attacker, defender])
  @@map("type_effects")
}

/// Progress markers for the resumable PokéAPI sync.
model SyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

// ============================================================================
// User data
// ============================================================================

enum UserRole {
  ADMIN
  USER
}

model User {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The first name; the one the menu shows.
  name           String
  lastName       String    @default("") @map("last_name")
  /// Lower case. Null for the demo user, which nobody logs in as.
  email          String?   @unique
  passwordHash   String?   @map("password_hash")
  role           UserRole  @default(USER)
  /// The user's own AI settings. The AI is paid by whoever set it up, and the server holds no AI key of its own.
  /// The provider ('claude' or 'openai'); the key, encrypted (see src/lib/secret-box.ts) with its last four
  /// characters to show which one it is; an Anthropic workspace id when their key needs one; and a model to use
  /// instead of the provider's default. All null when there is no AI.
  aiProvider     String?   @map("ai_provider")
  aiKeyEncrypted String?   @map("ai_key_encrypted")
  aiKeyHint      String?   @map("ai_key_hint")
  aiWorkspaceId  String?   @map("ai_workspace_id")
  aiModel        String?   @map("ai_model")
  /// When this user's data was last replaced by a copy of the admin's. Only the demo has one.
  dataCopiedAt   DateTime? @map("data_copied_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  profiles       GameProfile[]
  locations      PokemonLocation[]
  sessions       Session[]
  passwordResets PasswordReset[]
  invitesCreated Invite[]            @relation("InviteCreator")
  invitesUsed    Invite[]            @relation("InviteUser")
  suggestions    FeatureSuggestion[]

  @@map("users")
}

/// A login. It never expires: it ends when the player logs out or the admin removes it. Only the hash
/// of the token is kept; the token itself lives in the player's cookie.
model Session {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum InviteRequestStatus {
  PENDING
  INVITED
  DECLINED
}

/// Someone asking for an invite from the public page. The admin answers it by hand.
model InviteRequest {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  email     String
  /// What games they play, or anything else they want to say.
  message   String?
  status    InviteRequestStatus @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at")

  invite Invite?

  @@index([status, createdAt])
  @@map("invite_requests")
}

/// An idea for the app, sent from the public page. The admin reads them on the Admin page.
model FeatureSuggestion {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  message    String
  /// Who wrote it, when they said: a visitor may leave a name and an email to be answered at.
  name       String?
  email      String?
  /// The account it came from, when the sender was logged in.
  userId     String?   @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Set when the admin has dealt with it; it folds away but is not lost.
  archivedAt DateTime? @map("archived_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([archivedAt, createdAt])
  @@map("feature_suggestions")
}

/// A single-use link to register. Only the hash of its code is kept; the admin gets the link once.
model Invite {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  codeHash    String    @unique @map("code_hash")
  /// When set, only this email can use it.
  email       String?
  requestId   String?   @unique @map("request_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id") @db.Uuid

  request   InviteRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?          @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@map("invites")
}

/// A single-use link to choose a new password, made by the admin.
model PasswordReset {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model GameProfile {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  gameId       String   @map("game_id")
  name         String
  /// The stat the team is being trained in right now ('attack', 'speed'...), or null.
  trainingStat String?  @map("training_stat")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  pokedexEntries PokedexEntry[]
  roster         RosterPokemon[]
  breedingGoals  BreedingGoal[]
  importBatches  ImportBatch[]
  audits         AiAudit[]
  opponents      BattleOpponent[]
  teamSlots      TeamSlot[]

  @@unique([userId, gameId, name])
  @@map("game_profiles")
}

/// Caught state, stored once per profile and species. The National Pokédex
/// and "caught in another game" badges are derived by reading these rows
/// across all of a user's profiles -- nothing is duplicated.
model PokedexEntry {
  profileId String   @map("profile_id") @db.Uuid
  speciesId Int      @map("species_id")
  /// Which form of the species this entry is for: '' = its own form, or a region
  /// ('alola', 'galar', 'hisui', 'paldea') when a Pokédex lists that regional form separately.
  variant   String   @default("")
  caughtAt  DateTime @default(now()) @map("caught_at")
  /// The player has one of these right now. Caught-but-not-owned means it evolved or was
  /// released: the Pokédex still lists it, but there is none in the box. Existing and new
  /// entries start as owned.
  owned     Boolean  @default(true)
  /// Which genders the player has, for the breeding planner. Both false = not recorded.
  hasMale   Boolean  @default(false) @map("has_male")
  hasFemale Boolean  @default(false) @map("has_female")

  profile GameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  species Species     @relation(fields: [speciesId], references: [id])

  @@id([profileId, speciesId, variant])
  @@map("pokedex_entries")
}

enum TaskStatus {
  PENDING
  DONE
}

enum Gender {
  MALE
  FEMALE
  /// The player has both a male and a female of this Pokémon.
  BOTH
  GENDERLESS
  UNKNOWN
}

/// The in-game Judge's overall verdict on a Pokémon's potential (its IVs), lowest first.
/// In Spanish: aceptable, superior a la media, notable, extraordinario.
enum Potential {
  DECENT
  ABOVE_AVERAGE
  RELATIVELY_SUPERIOR
  OUTSTANDING
}

enum Origin {
  CAUGHT
  BRED
  UNKNOWN
}

/// Where a Pokémon is used. One Pokémon can be on the trained roster, in the breeders, or both.
enum PokemonRole {
  ROSTER
  BREEDER
}

/// One trained (or to-be-trained) Pokémon. Each trainable aspect carries its
/// own PENDING/DONE status; the card is complete when all of them are DONE.
model RosterPokemon {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId      String  @map("profile_id") @db.Uuid
  /// The stage it is at right now, e.g. Vigoroth. Stats, abilities and moves are read from this one.
  speciesId      Int     @map("species_id")
  formId         Int?    @map("form_id")
  /// The species bred or caught to get there, e.g. Geodude.
  baseSpeciesId  Int?    @map("base_species_id")
  /// Marked by the player: a "keeper": finished and kept (shown with crossed swords), and being trained right now. Only marks and filters.
  keeper         Boolean @default(false)
  training       Boolean @default(false)
  /// Left out of the breeding plans, so a repeated Pokémon can be kept recorded without counting.
  breedingOff    Boolean @default(false) @map("breeding_off")
  /// The stage it is meant to end as, e.g. Slaking while it is a Slakoth. Null = the stage it is at now is the final one.
  finalSpeciesId Int?    @map("final_species_id")
  nickname       String?
  gender         Gender  @default(UNKNOWN)
  origin         Origin  @default(UNKNOWN)
  /// False until the Pokémon is actually in the player's possession.
  owned          Boolean @default(false)

  targetNatureId  Int?       @map("target_nature_id")
  currentNatureId Int?       @map("current_nature_id")
  natureStatus    TaskStatus @default(PENDING) @map("nature_status")
  /// The nature of the Mint it was given: the game then uses this one's stat effect (the real nature stays).
  mintNatureId    Int?       @map("mint_nature_id")
  /// DONE once the Mint has been given. Until then it is only the one chosen, and the stats do not feel it.
  mintStatus      TaskStatus @default(PENDING) @map("mint_status")
  /// The nature effect the recorded stats were read under. The EVs are worked out with it, so a Mint given
  /// afterwards does not change them until the stats are read again.
  statsNatureId   Int?       @map("stats_nature_id")

  abilityId     Int?       @map("ability_id")
  abilityStatus TaskStatus @default(PENDING) @map("ability_status")

  itemId     Int?       @map("item_id")
  /// Free text when the sheet lists alternatives ("Life Orb or Choice Band").
  itemNote   String?    @map("item_note")
  itemStatus TaskStatus @default(PENDING) @map("item_status")

  /// The EV spread the player is aiming for: { hp, attack, defense, specialAttack, specialDefense, speed },
  /// or null if not planned.
  evs                 Json?
  evStatus            TaskStatus @default(PENDING) @map("ev_status")
  /// The EVs the Pokémon has right now, same shape. Null = not recorded.
  currentEvs          Json?      @map("current_evs")
  /// True when those EVs were worked out from the stats rather than read off the game.
  currentEvsEstimated Boolean    @default(false) @map("current_evs_estimated")
  /// The stats the game shows (the blue graph), same shape as EVs. The EVs are worked out from these.
  currentStats        Json?      @map("current_stats")
  /// Its level, which the stats depend on.
  level               Int        @default(100)
  /// What the Judge said about each stat's IV: { hp: "PERFECT", attack: "LOW", ... }. Missing = not judged.
  ivRatings           Json?      @map("iv_ratings")
  /// The stats whose EVs the game shows sparkling (252): ["attack", "speed"]. Null = not looked at; once
  /// recorded, a stat left out is one the game shows as not full.
  maxedEvs            Json?      @map("maxed_evs")
  /// Parts of the AI audit the player has fixed: { heldItem?, moves? }. Re-running the audit keeps them.
  auditLocks          Json?      @map("audit_locks")

  teraType   String?    @map("tera_type")
  teraStatus TaskStatus @default(PENDING) @map("tera_status")
  /// What the Judge said, for games that have one. Null = not judged yet.
  potential  Potential?
  notes      String?
  sortOrder  Int        @default(0) @map("sort_order")

  importBatchId String?  @map("import_batch_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile       GameProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  species       Species      @relation("RosterSpecies", fields: [speciesId], references: [id])
  baseSpecies   Species?     @relation("RosterBaseSpecies", fields: [baseSpeciesId], references: [id])
  finalSpecies  Species?     @relation("RosterFinalSpecies", fields: [finalSpeciesId], references: [id])
  form          Form?        @relation(fields: [formId], references: [id])
  targetNature  Nature?      @relation("TargetNature", fields: [targetNatureId], references: [id])
  currentNature Nature?      @relation("CurrentNature", fields: [currentNatureId], references: [id])
  mintNature    Nature?      @relation("MintNature", fields: [mintNatureId], references: [id])
  statsNature   Nature?      @relation("StatsNature", fields: [statsNatureId], references: [id])
  ability       Ability?     @relation(fields: [abilityId], references: [id])
  item          Item?        @relation(fields: [itemId], references: [id])
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  moves    RosterMove[]
  audits   AiAudit[]
  roles    PokemonRoleAssignment[]
  teamSlot TeamSlot?

  @@index([profileId, sortOrder])
  @@map("roster_pokemon")
}

/// Which pages a Pokémon appears on. The Pokémon itself (species, stats, IV words, ...) is
/// stored once in RosterPokemon; a Pokémon with no role left is deleted.
model PokemonRoleAssignment {
  rosterPokemonId String      @map("roster_pokemon_id") @db.Uuid
  role            PokemonRole

  rosterPokemon RosterPokemon @relation(fields: [rosterPokemonId], references: [id], onDelete: Cascade)

  @@id([rosterPokemonId, role])
  @@map("pokemon_roles")
}

model RosterMove {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  rosterPokemonId String     @map("roster_pokemon_id") @db.Uuid
  slot            Int // 1..4
  moveId          Int?       @map("move_id")
  /// What the sheet said, kept when the move could not be matched.
  rawName         String?    @map("raw_name")
  status          TaskStatus @default(PENDING)
  /// Result of the deterministic learnset check; null = not checked yet.
  legal           Boolean?

  rosterPokemon RosterPokemon @relation(fields: [rosterPokemonId], references: [id], onDelete: Cascade)
  move          Move?         @relation(fields: [moveId], references: [id])

  @@unique([rosterPokemonId, slot])
  @@map("roster_moves")
}

model BreedingGoal {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  speciesId     Int      @map("species_id")
  /// Move ids the offspring should know.
  moveIds       Int[]    @map("move_ids")
  natureId      Int?     @map("nature_id")
  /// Stats whose IV must be 31 (stat keys: hp, attack, defense, specialAttack, specialDefense, speed).
  ivTargets     String[] @default([]) @map("iv_targets")
  /// The offspring should have the hidden ability.
  hiddenAbility Boolean  @default(false) @map("hidden_ability")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  profile GameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  species Species     @relation(fields: [speciesId], references: [id])

  @@map("breeding_goals")
}

model ImportBatch {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  fileName  String   @map("file_name")
  mapping   Json
  rowCount  Int      @map("row_count")
  createdAt DateTime @default(now()) @map("created_at")

  profile GameProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  roster  RosterPokemon[]

  @@map("import_batches")
}

/// Where to catch a species in a game's map, shared by every user: the first lookup (by anyone with
/// AI) is saved here and every later one reads it for free. Keyed by version group, so Scarlet and
/// Violet, which share a map, share the answer.
model PokemonLocation {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  versionGroup  String   @map("version_group")
  speciesId     Int      @map("species_id")
  /// Reserved for a regional form that lives somewhere else than its species; '' for now.
  variant       String   @default("")
  /// { en?: LocationResult, es?: LocationResult }. A lookup fills both; older answers may have one.
  result        Json
  /// Who found it, and how: provider and model are null for answers brought over from the old cache.
  provider      String?
  model         String?
  promptVersion Int      @map("prompt_version")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([versionGroup, speciesId, variant])
  @@map("pokemon_locations")
}

/// An AI result, and its cache: the same kind + inputHash is never paid for twice.
model AiAudit {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid
  rosterPokemonId String?  @map("roster_pokemon_id") @db.Uuid
  kind            String // build | team | location | breeding-path
  provider        String
  model           String
  inputHash       String   @map("input_hash")
  /// Language the answer is written in. Switching the app language does not translate it:
  /// the saved answer stays until it is re-run.
  lang            String   @default("es")
  result          Json
  createdAt       DateTime @default(now()) @map("created_at")

  profile       GameProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rosterPokemon RosterPokemon? @relation(fields: [rosterPokemonId], references: [id], onDelete: Cascade)

  /// Per profile: the same question asked in two profiles (a copy of a profile, for one) is two rows.
  @@unique([profileId, kind, provider, inputHash])
  @@map("ai_audits")
}

enum BattleKind {
  /// A boss from a raid (Tera raid in Scarlet/Violet).
  RAID
  /// Any other Pokémon to battle.
  STANDARD
}

/// A Pokémon the player has to beat, saved so the counters can be looked at again and the
/// entry cloned (to change the Tera type, say). What to use against it is computed, not stored.
model BattleOpponent {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId    String     @map("profile_id") @db.Uuid
  speciesId    Int        @map("species_id")
  /// A specific form (regional form...); null = the species' default form.
  formId       Int?       @map("form_id")
  kind         BattleKind @default(STANDARD)
  /// Tera type of a raid boss; replaces its types when defending. Null = not Terastallized.
  teraType     String?    @map("tera_type")
  /// Raid star level, 1..7.
  stars        Int?
  abilityId    Int?       @map("ability_id")
  /// Moves the player has seen it use (up to 4). When set, the hits a counter takes come from
  /// these instead of from the opponent's own types.
  moveIds      Int[]      @default([]) @map("move_ids")
  /// The player's own label, e.g. "Charizard 7★ raid".
  label        String?
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  /// Set when put away: it stays saved but is kept out of the open list.
  archivedAt   DateTime?  @map("archived_at")
  /// Set when the player has beaten it; it stays in the list, marked.
  defeatedAt   DateTime?  @map("defeated_at")
  /// The roster entry the player found best against it. Kept across refreshes; a stale id is ignored.
  bestRosterId String?    @map("best_roster_id") @db.Uuid
  /// What the counters looked like when it was marked defeated: shown as is while it stays defeated.
  frozen       Json?

  profile GameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  species Species     @relation(fields: [speciesId], references: [id])

  @@index([profileId])
  @@map("battle_opponents")
}

/// The team being trained in a game: up to six roster Pokémon, one per slot. Two roster
/// entries of the same species are two different Pokémon and may both be in it.
model TeamSlot {
  id              String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId       String @map("profile_id") @db.Uuid
  /// 1 to 6.
  slot            Int
  rosterPokemonId String @map("roster_pokemon_id") @db.Uuid

  profile       GameProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rosterPokemon RosterPokemon @relation(fields: [rosterPokemonId], references: [id], onDelete: Cascade)

  @@unique([profileId, slot])
  @@unique([rosterPokemonId])
  @@map("team_slots")
}
