{
  "name": "poketrain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config prisma/seed.ts",
    "db:reset": "DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/db-reset.ts",
    "locations:import-legacy": "DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/import-legacy-locations.ts",
    "accounts": "DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/accounts.ts",
    "sync:pokeapi": "DOTENV_CONFIG_PATH=.env.local tsx --import dotenv/config scripts/sync-pokeapi.ts",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
